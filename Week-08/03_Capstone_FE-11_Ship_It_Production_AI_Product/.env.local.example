# Copy this file to .env.local and fill in your own values.
# .env.local is already git-ignored. Never commit real API keys.

# Required for the AI Insights feature (app/api/insights/route.js).
# Free key, no card required: https://aistudio.google.com/ -> "Get API key"
GEMINI_API_KEY=your-gemini-key-here

# Optional. Defaults to gemini-2.5-flash if not set.
GEMINI_MODEL=gemini-2.5-flash
